# Server & Port Configuration
PORT=8080
ENV=development
SERVICE_NAME=mercury-dasha
BOLT_DB_PATH=.data/mercury-dasha-dev.db

# Dropbox Integration (Optional)
# If omitted or unconfigured, astronomical and dasha calculations run completely offline.
DROPBOX_LOCAL_PATH=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_BACKUP_PATH=/MercuryDasha/backups

# YouTube Studio Integration (Optional)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URL=http://localhost:8080/api/v1/youtube/auth/callback
